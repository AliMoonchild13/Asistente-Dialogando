# =====================================================================
#  Configuración del Asistente de Movilidad Internacional
#  Este es el ÚNICO archivo que hay que editar. Ábrelo con el Bloc de notas.
#  No dejes espacios alrededor del signo "=".
# =====================================================================

# --- 1. Base de datos -------------------------------------------------
# Pon una clave ANTES de la primera ejecución (solo letras y números, sin espacios ni símbolos).
# Si la cambias después, la base deja de abrir.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_DB=movilidad_udec
POSTGRES_PORT=5433

# --- 2. Servicio de IA ------------------------------------------------
# Clave del servicio (la de Groq empieza por gsk_).
LLM_API_KEY=PEGAR_AQUI_LA_CLAVE
# Solo se cambian estas dos líneas si se usa otro proveedor distinto de Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=openai/gpt-oss-120b

# --- 3. Datos ---------------------------------------------------------
# Excel de movilidad: nombre del archivo (si está en esta carpeta) o ruta completa, por ejemplo
# ARCHIVO_EXCEL=C:\Users\NOMBRE\Universidad de Cundinamarca\Dialogando con el Mundo - Documentos\BD movilidad.xlsx
ARCHIVO_EXCEL=BD_UNION_MOVILIDAD_LIMPIA_con_fechas.xlsx
# Carpeta con los informes en PDF. Si se deja vacío, usa la carpeta "informes" de aquí.
# Para usar la carpeta sincronizada de SharePoint/OneDrive, escribe la ruta completa.
CARPETA_INFORMES=
