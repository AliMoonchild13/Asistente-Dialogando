# =====================================================================
#  Configuración del Asistente de Movilidad Internacional
#  Este es el ÚNICO archivo que hay que editar. Ábrelo con el Bloc de notas.
#  No dejes espacios alrededor del signo "=" y no uses comillas.
#  Después de cambiarlo:  docker compose up -d
# =====================================================================

# --- 1. Base de datos -------------------------------------------------
# Pon una clave ANTES de la primera instalación (solo letras y números).
# Si la cambias después de instalar, la base deja de abrir.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_DB=movilidad_udec
# Puerto para conectarse desde este equipo con pgAdmin o Power BI Desktop
POSTGRES_PORT=5433

# --- 2. Modelo de inteligencia artificial ------------------------------
# MODELO PRINCIPAL. Opción A (predeterminada): modelo LOCAL con Ollama. No necesita clave ni internet
# (solo para descargar el modelo la primera vez, unos 5 GB). Más lento sin tarjeta gráfica.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODELO=llama3.1:8b
LLM_API_KEY=
#
# Opción B: servicio externo compatible con OpenAI (por ejemplo Groq o la API de la universidad).
# Más rápido y preciso. Para usarlo, pon un # delante de las 3 líneas de arriba y quítalo de estas:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODELO=openai/gpt-oss-120b
# LLM_API_KEY=PEGAR_AQUI_LA_CLAVE

# MODELO DE RESPALDO (opcional): se usa automáticamente si el principal falla
# (sin internet, límite diario alcanzado, clave vencida o servicio caído).
# Recomendado si el principal es la opción B. Si el principal es Ollama, deja estas líneas con #.
# LLM_RESPALDO_BASE_URL=http://ollama:11434/v1
# LLM_RESPALDO_MODELO=llama3.1:8b

# --- 3. Carpetas de datos ----------------------------------------------
# Si se dejan vacías se usan datos\excel y datos\informes de esta carpeta.
# Para usar la carpeta sincronizada de SharePoint/OneDrive, escribe la ruta completa, por ejemplo:
# CARPETA_EXCEL=C:\Users\NOMBRE\Universidad de Cundinamarca\Dialogando con el Mundo - Documentos\Base movilidad
# CARPETA_INFORMES=C:\Users\NOMBRE\Universidad de Cundinamarca\Dialogando con el Mundo - Documentos\Informes
# En el Excel no importa el nombre del archivo: se usa el .xlsx más reciente de la carpeta.
CARPETA_EXCEL=./datos/excel
CARPETA_INFORMES=./datos/informes
# Carpeta donde se guarda el archivo para Power BI (movilidad_powerbi.xlsx, con nombres y sin documentos).
# Cuando se instale, puede ser una carpeta sincronizada de SharePoint.
CARPETA_POWERBI=./datos/powerbi

# --- 4. Opciones (normalmente no se cambian) ----------------------------
# Puerto de la página: http://localhost:8000
PUERTO_ASISTENTE=8000
# Cada cuántos minutos se revisa si hay un Excel o informes nuevos
INTERVALO_REVISION_MIN=10
# Cuántas copias de seguridad de la base se conservan
MAX_RESPALDOS=15
# Versión de Ollama (revisar la más reciente estable en https://hub.docker.com/r/ollama/ollama)
OLLAMA_VERSION=0.9.0
